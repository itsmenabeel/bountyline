# Copy to .env.local and fill in. next.config.ts validates every variable at startup.

# ---- Server only (never exposed to the browser) ----

# Backend base URL including /api/v1. Local backend: http://localhost:5000/api/v1
API_BASE_URL=https://bug-bounty-platform-cuna.onrender.com/api/v1

# Must equal the backend's JWT_ACCESS_SECRET (proxy.ts verifies access tokens with it).
JWT_ACCESS_SECRET=

# Must equal the backend's BFF_SHARED_SECRET. Lets the backend rate-limit per visitor.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BFF_SHARED_SECRET=

# One-click demo login accounts (seeded by the backend).
DEMO_ADMIN_EMAIL=admin@bugbounty.dev
# Production uses the backend's SEED_ADMIN_PASSWORD; the local seed default is Admin@12345.
DEMO_ADMIN_PASSWORD=
DEMO_OWNER_EMAIL=owner@bugbounty.dev
DEMO_OWNER_PASSWORD=Demo@12345
DEMO_RESEARCHER_EMAIL=researcher@bugbounty.dev
DEMO_RESEARCHER_PASSWORD=Demo@12345

# ---- Public (inlined into the browser bundle) ----

# Origin of this frontend, used for metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same OAuth client ID as the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Inbox the contact form writes to. Shown on the public contact page.
NEXT_PUBLIC_CONTACT_EMAIL=nabeel23456787@gmail.com
